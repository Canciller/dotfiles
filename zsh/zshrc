# ==============================================================================
# ROOT FALLBACK
# ==============================================================================

if [ $UID = 0 ]; then
    [ -f "$HOME/.zshenv" ] && source "$HOME/.zshenv"
fi

# ==============================================================================
# HELPER FUNCTIONS
# ==============================================================================

# Add a directory to PATH unless it's already there.
# Prepends by default; pass "append" as 2nd arg to add it at the end.
function path {
	case ":$PATH:" in
	  *":$1:"*) :;; # already there
	  *)
	    if [ "$2" = "append" ]; then
	      PATH="$PATH:$1"
	    else
	      PATH="$1:$PATH"
	    fi;;
	esac
}

# Succeeds only if every given command exists
function command_exists {
	[ -z "$1" ] && return 1

	for i in "$@"; do
	    command -v "$i" &>/dev/null || return 1
	done

	return 0
}

# ==============================================================================
# OH MY ZSH
# ==============================================================================

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="candy"

# sensitive completion must be off. _ and - will be interchangeable.
HYPHEN_INSENSITIVE="true"

# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  history
  # archlinux
  # systemd
  sudo
  git
  # pip
  # python
  npm
  brew
  zsh-autosuggestions
  docker
  docker-compose
  # rust
)

[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ==============================================================================
# COMPLETION & PLUGIN SETTINGS
# ==============================================================================

zstyle ':completion:*' rehash true

# zsh-autosuggestions
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=white,bold"

# zsh-syntax-highlighting
source "$HOME/.zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ==============================================================================
# BASE PATH
# ==============================================================================

path /usr/local/bin
path /usr/local/sbin

path $HOME/.local/bin
path $HOME/.bin

# ==============================================================================
# EDITOR
# ==============================================================================

EDITOR="vi"

if command_exists "nvim"; then
    EDITOR="nvim"
elif command_exists "vim"; then
    EDITOR="vim"
fi

export EDITOR

# ==============================================================================
# JAVA
# ==============================================================================

path $HOME/.jenv/bin
eval "$(jenv init -)"

# JAVA_HOME is managed by jenv (export plugin: jenv enable-plugin export)

# ==============================================================================
# RUBY
# ==============================================================================

export GEM_HOME=$HOME/.gem
path $GEM_HOME/bin

eval "$(rbenv init - zsh)"

# ==============================================================================
# NODE / PNPM
# ==============================================================================

eval "$(fnm env --use-on-cd --shell zsh)"

export PNPM_HOME="$HOME/Library/pnpm"
path $PNPM_HOME
path $PNPM_HOME/bin

# ==============================================================================
# RUST
# ==============================================================================

if [ -f "$HOME/.cargo/env" ]; then
	source "$HOME/.cargo/env"
fi

# ==============================================================================
# GO
# ==============================================================================

path $HOME/go/bin append

# ==============================================================================
# ANDROID
# ==============================================================================

export ANDROID_HOME=$HOME/Library/Android/Sdk

path $ANDROID_HOME/emulator
path $ANDROID_HOME/tools
path $ANDROID_HOME/tools/bin
path $ANDROID_HOME/platform-tools

# ==============================================================================
# GOOGLE CLOUD SDK
# ==============================================================================

source "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc"
source "$(brew --prefix)/share/google-cloud-sdk/completion.zsh.inc"

# ==============================================================================
# CROWDIN
# ==============================================================================

path /opt/homebrew/opt/crowdin@3/bin append

# ==============================================================================
# SHELL TOOLS
# ==============================================================================

# zoxide
eval "$(zoxide init zsh)"

# fzf
source <(fzf --zsh)

# atuin (after fzf so it owns Ctrl-R)
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# rover
source "$HOME/.rover/env"

# ==============================================================================
# ALIASES
# ==============================================================================

# kitty
alias ssh="kitty +kitten ssh"
